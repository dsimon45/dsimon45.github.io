---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .gallery-item {
    margin: 0;
  }
  .gallery-item a {
    display: block;
    overflow: hidden;
    border-radius: 6px;
  }
  .gallery-item img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .gallery-item a:hover img {
    transform: scale(1.04);
  }
  .gallery-caption {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--global-text-color-light, #888);
    text-align: center;
    line-height: 1.3;
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  <article>
    {{ content }}

    {% assign folder = page.folder | default: '' %}
    {% assign folder_trimmed = folder | remove_first: '/' | remove: '/' | append: '' %}

    <div class="pswp-gallery gallery-grid" id="gallery-{{ page.slug | default: page.title | slugify }}">
      {% if page.images_list and page.images_list.size > 0 %}
        {% for img in page.images_list %}
          {% assign src = folder | append: '/' | append: img.file | replace: '//', '/' %}
          <figure class="gallery-item">
            <a href="{{ src | relative_url }}"
               data-pswp-width="1600"
               data-pswp-height="1200"
               {% if img.caption %}data-pswp-caption="{{ img.caption | escape }}"{% endif %}>
              <img src="{{ src | relative_url }}" alt="{{ img.caption | default: img.file | escape }}" loading="lazy" />
            </a>
            {% if img.caption %}
              <figcaption class="gallery-caption">{{ img.caption }}</figcaption>
            {% endif %}
          </figure>
        {% endfor %}
      {% else %}
        {% comment %} Auto-discover all images in the folder {% endcomment %}
        {% assign captions_map = '' %}
        {% if page.captions %}
          {% assign captions_map = page.captions %}
        {% endif %}
        {% assign folder_prefix = folder | append: '/' %}
        {% comment %} Exclude `.webp` because jekyll-imagemagick auto-generates webp variants from JPG/PNG sources. {% endcomment %}
        {% assign image_exts = '.jpg,.jpeg,.png,.gif,.tiff,.JPG,.JPEG,.PNG,.GIF,.TIFF' | split: ',' %}
        {% for static in site.static_files %}
          {% assign in_folder = static.path | slice: 0, folder_prefix.size %}
          {% if in_folder == folder_prefix and image_exts contains static.extname %}
            {% assign caption = '' %}
            {% if captions_map %}
              {% assign caption = captions_map[static.name] %}
            {% endif %}
            <figure class="gallery-item">
              <a href="{{ static.path | relative_url }}"
                 data-pswp-width="1600"
                 data-pswp-height="1200"
                 {% if caption %}data-pswp-caption="{{ caption | escape }}"{% endif %}>
                <img src="{{ static.path | relative_url }}" alt="{{ caption | default: static.name | escape }}" loading="lazy" />
              </a>
              {% if caption %}
                <figcaption class="gallery-caption">{{ caption }}</figcaption>
              {% endif %}
            </figure>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
  </article>
</div>

<script>
  // Detect actual image dimensions and set them on the anchors so PhotoSwipe sizes correctly.
  (function () {
    function applyDims() {
      document.querySelectorAll('.pswp-gallery a').forEach(function (link) {
        var probe = new Image();
        probe.onload = function () {
          link.setAttribute('data-pswp-width', probe.naturalWidth);
          link.setAttribute('data-pswp-height', probe.naturalHeight);
        };
        probe.src = link.getAttribute('href');
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', applyDims);
    } else {
      applyDims();
    }
  })();
</script>
